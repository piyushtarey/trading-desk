# Trading Desk — server config (M1 safety rails)
# Copy to .env.local and fill in. NEVER commit .env.local.
# All DESK_* vars are server-only: read exclusively by lib/server/* and
# Route Handlers. Do not add NEXT_PUBLIC_ secrets.

# Kill switch on boot: "true" starts halted (fail closed). Default: live-but-gated.
DESK_TRADING_HALTED=false

# Dry-run default: anything except "false" means order intents validate + audit
# but never submit. Keep unset/true until the M3 venue adapter exists.
DESK_DRY_RUN=true

# Risk caps (conservative canary defaults in code — uncomment to override).
# DESK_MAX_NOTIONAL_PER_TRADE_USD=1000
# DESK_MAX_LEVERAGE=5
# DESK_MAX_OPEN_POSITIONS=3
# DESK_MAX_DAILY_LOSS_USD=500

# Optional JSONL audit trail file. Also always logged to structured stdout.
# DESK_AUDIT_LOG_PATH=./trading-audit.jsonl

# --- M3: live venue orders (GMX v2, default OFF) ---
# Enable ONLY on testnet first, with every address verified (see docs/OPERATIONS.md).
DESK_LIVE_ORDERS_ENABLED=false
# 42161 = Arbitrum One, 421614 = Arbitrum Sepolia (testnet).
DESK_GMX_CHAIN_ID=42161
# DESK_GMX_RPC_URL=https://arb1.arbitrum.io/rpc
#
# Addresses below are EXAMPLES copied from GMX docs / GMX API on 2026-09-17 —
# re-verify each on Arbiscan + https://docs.gmx.io/docs/api/contracts/addresses
# before use. Routers change across upgrades; the app checks bytecode at prepare
# time and refuses to build against dead/stale addresses.
# DESK_GMX_EXCHANGE_ROUTER=0x7dE39FF2e232A2203196788d37e234cF8F1b83f1
# DESK_GMX_ORDER_VAULT=0x31eF83a530Fde1B38EE9A18093A333D8Bbbc40D5
# DESK_GMX_ROUTER=0x7452c558d45f8afC8c83dAe62C3f8A5BE19c71f6
# DESK_GMX_EXECUTION_FEE_WEI=800000000000000
# DESK_GMX_SLIPPAGE_BPS=50
#
# Market allowlist (JSON array). WETH 0x82aF49447D8a07e3bd95BD0d56f35241523fBab1 and
# USDC 0xaf88d065e77c8cC2239327C5EDb3A432268e5831 corroborated via GMX markets API.
# ETH/USD [ETH-USDC] market 0x70d95587d40A2caf56bd97485aB3Eec10Bee6336 likewise.
# DESK_GMX_MARKETS_JSON=[{"symbol":"ETH/USDC","market":"0x70d95587d40A2caf56bd97485aB3Eec10Bee6336","indexToken":"0x82aF49447D8a07e3bd95BD0d56f35241523fBab1","indexDecimals":18,"longToken":"0x82aF49447D8a07e3bd95BD0d56f35241523fBab1","shortToken":"0xaf88d065e77c8cC2239327C5EDb3A432268e5831","priceCoinId":"ethereum","collateralToken":"0xaf88d065e77c8cC2239327C5EDb3A432268e5831","collateralDecimals":6}]

# --- M6: paper-mode dev harness (default OFF) ---
# "true" restores the legacy paper behavior for LOCAL DEV ONLY: engine paper
# fills, paper ticket execution, demo wallet. Never enable in any shared or
# production build — the UI labels it PAPER but the numbers are still fake.
# NEXT_PUBLIC_DESK_PAPER_MODE=false

# --- M4: LLM scout/analyst (server-side only, default OFF) ---
# Modes: off | shadow (log agreement, deterministic wins) | advisory (show labeled
# second opinion) | proposing (REFUSED by routes — ticket creation from model
# output is not implemented).
# DESK_LLM_MODE=off
# Provider: openai (chat completions, JSON mode) or anthropic (messages API).
# DESK_LLM_PROVIDER=openai
# DESK_LLM_MODEL=gpt-4o-mini
# DESK_LLM_API_KEY=
# Optional proxy/custom endpoint (must speak the provider's API).
# DESK_LLM_API_URL=
# Budgets: 5s..120s timeout, 100..4000 tokens, one retry on 429/5xx only.
# DESK_LLM_TIMEOUT_MS=25000
# DESK_LLM_MAX_TOKENS=800
